            "enabled": true
          },
          "registrarAuditoriaIsActive": {
            "enabled": true,
            "onError": "continueRegularOutput",
            "waitForSubWorkflow": false,
            "actionExpression": "={{ $('Aplicar isActive').first().json.isActive === false ? 'DOCUMENT_DEACTIVATED' : 'DOCUMENT_ACTIVATED' }}"
          },
          "invalidarCache": {
            "targetWorkflowId": "c221InvalidateEvent01",
            "onError": "continueRegularOutput",
            "waitForSubWorkflow": false,
            "eventTypeExpression": "={{ $('Aplicar isActive').first().json.isActive === false ? 'DOCUMENT_DEACTIVATED' : 'DOCUMENT_ACTIVATED' }}",
            "documentIdExpression": "={{ String($('Aplicar isActive').first().json.id || '') }}",
            "reasonCodeExpression": "={{ $('Aplicar isActive').first().json.isActive === false ? 'DOCUMENT_DEACTIVATED' : 'DOCUMENT_ACTIVATED' }}",
            "requestIdExpression": "={{ $('Normalizar request').first().json.requestId || '' }}"
          },
          "qdrantSetPayload": {
            "method": "POST",
            "url": "http://qdrant:6333/collections/oftalmocentro_chunks/points/payload",
            "neverError": true,
            "onError": "continueRegularOutput"
          }
        }
      }
    },
