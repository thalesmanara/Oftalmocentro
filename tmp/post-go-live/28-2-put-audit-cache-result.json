      "mainPathIntact": [
        "Aplicar isActive -> Montar data -> Preparar sucesso -> Registrar auditoria sucesso -> Respond to Webhook"
      ],
      "parallelBranch": {
        "flow": "Aplicar isActive -> isActive mudou? -> Registrar auditoria isActive -> Invalidar cache -> Qdrant set payload isActive",
        "aplicarIsActiveOutputs": [
          "Montar data",
          "isActive mudou?"
