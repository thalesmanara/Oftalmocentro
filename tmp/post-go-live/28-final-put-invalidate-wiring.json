    {
      "name": "Preparar flags isActive",
      "type": "n8n-nodes-base.code",
      "disabled": false,
      "params": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const doc = $input.first().json || {};\nconst body = ($('Normalizar request').first().json.body) || ($('Webhook').first().json.body) || {};\nconst provided = Object.prototype.hasOwnProperty.call(body, 'isActive') || Object.prototype.hasOwnProperty.call(body, 'is_active');\nconst raw = body.isActive !== undefined ? body.isActive : body.is_active;\nconst newIsActive = raw === true || raw === 1 || raw === 'true' || raw === '1';\nreturn [{ json: { ...doc, __isActiveProvided: provided, __newIsActive: newIsActive } }];"
      }
