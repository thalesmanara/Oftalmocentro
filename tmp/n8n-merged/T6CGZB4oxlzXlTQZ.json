{"id":"T6CGZB4oxlzXlTQZ","name":"UPDATE Subcategory","nodes":[{"parameters":{"httpMethod":"PUT","path":"subcategories/update","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"aab8cc18-cc6b-4019-a482-88d3fd0c014f","name":"Webhook","webhookId":"4b538c91-450b-4372-8c3d-cfb6d304efc2"},{"parameters":{"operation":"executeQuery","query":"UPDATE subcategories\nSET\n  category_id =\n    COALESCE(\n      NULLIF('{{ $json.body.categoryId || \"\" }}', '')::uuid,\n      category_id\n    ),\n\n  name =\n    CASE\n      WHEN NULLIF(\n        '{{ ($json.body.name || \"\").replace(/'/g, \"''\") }}',\n        ''\n      ) IS NOT NULL\n      THEN '{{ ($json.body.name || \"\").replace(/'/g, \"''\") }}'\n      ELSE name\n    END,\n\n  description =\n    CASE\n      WHEN '{{ $json.body.description !== undefined }}' = 'true'\n      THEN NULLIF(\n        '{{ ($json.body.description || \"\").replace(/'/g, \"''\") }}',\n        ''\n      )\n      ELSE description\n    END,\n\n  active =\n    CASE\n      WHEN '{{ $json.body.active !== undefined }}' = 'true'\n      THEN '{{ $json.body.active }}'::boolean\n      ELSE active\n    END,\n\n  updated_at = NOW()\n\nWHERE id = '{{ $json.body.id }}'::uuid\n\nRETURNING\n  id,\n  category_id AS \"categoryId\",\n  (\n    SELECT c.name\n    FROM categories c\n    WHERE c.id = subcategories.category_id\n  ) AS \"categoryName\",\n  name,\n  description,\n  active,\n  created_at AS \"createdAt\",\n  updated_at AS \"updatedAt\";","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[208,0],"id":"2e600cdc-7ecd-4dac-94cd-1845e2d12ab9","name":"Execute a SQL query","credentials":{"postgres":{"id":"XJtGZ5rpCR7BpN0X","name":"Postgres account"}}},{"parameters":{"options":{"responseCode":"={{ $json.statusCode }}","responseHeaders":{"entries":[{"name":"X-Request-Id","value":"={{ $json.responseHeaders && $json.responseHeaders[\"X-Request-Id\"] ? $json.responseHeaders[\"X-Request-I