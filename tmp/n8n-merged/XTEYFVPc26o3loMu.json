        "query": "SELECT\n  sc.id,\n  sc.category_id AS \"categoryId\",\n  c.name AS \"categoryName\",\n  sc.name,\n  sc.description,\n  sc.active,\n  sc.created_at AS \"createdAt\",\n  sc.updated_at AS \"updatedAt\"\nFROM subcategories sc\nINNER JOIN categories c\n  ON c.id = sc.category_id\nWHERE\n  (\n    NULLIF('{{ $json.query.categoryId || \"\" }}', '') IS NULL\n    OR sc.category_id =\n      NULLIF('{{ $json.query.categoryId || \"\" }}', '')::uuid\n  )\n  AND (\n    NULLIF('{{ $json.query.active || \"\" }}', '') IS NULL\n    OR sc.active =\n      NULLIF('{{ $json.query.active || \"\" }}', '')::boolean\n  )\nORDER BY\n  c.name ASC,\n  sc.name ASC;",
