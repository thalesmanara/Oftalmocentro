    {
      "parameters": {
        "jsCode": "const documentId = $('Preparar texto extraído').first().json.documentId;\nconst text = $('Preparar texto extraído').first().json.extractedText || '';\n\nconst cleanText = text\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst chunkSize = 1200;\nconst overlap = 150;\n\nconst chunks = [];\n\nfor (let i = 0; i < cleanText.length; i += chunkSize - overlap) {\n  const content = cleanText.slice(i, i + chunkSize).trim();\n\n  if (content.length > 50) {\n    chunks.push({\n      json: {\n        documentId,\n        chunkIndex: chunks.length,\n        content\n      }\n    });\n  }\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
