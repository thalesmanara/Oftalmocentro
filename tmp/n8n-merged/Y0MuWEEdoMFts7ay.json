{"id":"Y0MuWEEdoMFts7ay","name":"PUT Documentos","nodes":[{"parameters":{"httpMethod":"PUT","path":"documents/update","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"cb081234-1bc8-42a0-a67d-1651e8c815bc","name":"Webhook","webhookId":"ddd82c15-e2e9-4521-b630-37424a447b36"},{"parameters":{"operation":"executeQuery","query":"WITH updated_document AS (\n  UPDATE documents\n  SET\n    title =\n      COALESCE(\n        NULLIF(\n          '{{ ($json.body.title || \"\").replace(/'/g, \"''\") }}',\n          ''\n        ),\n        title\n      ),\n\n    sector_id =\n      COALESCE(\n        NULLIF(\n          '{{ $json.body.sectorId || \"\" }}',\n          ''\n        )::uuid,\n        sector_id\n      ),\n\n    category_id =\n      COALESCE(\n        NULLIF(\n          '{{ $json.body.categoryId || \"\" }}',\n          ''\n        )::uuid,\n        category_id\n      ),\n\n    subcategory_id =\n      CASE\n        WHEN '{{ $json.body.subcategoryId !== undefined }}' = 'true'\n        THEN NULLIF(\n          '{{ $json.body.subcategoryId || \"\" }}',\n          ''\n        )::uuid\n        ELSE subcategory_id\n      END,\n\n    semantic_description =\n      CASE\n        WHEN '{{ $json.body.semanticDescription !== undefined }}' = 'true'\n        THEN NULLIF(\n          '{{ ($json.body.semanticDescription || \"\").replace(/'/g, \"''\") }}',\n          ''\n        )\n        ELSE semantic_description\n      END,\n\n    expiration_date =\n      CASE\n        WHEN '{{ $json.body.expirationDate !== undefined }}' = 'true'\n        THEN NULLIF(\n          '{{ $json.body.expirationDate || \"\" }}',\n          ''\n        )::date\n        ELSE expiration_date\n      END,\n\n    responsible_user_id =\n      CASE\n        WHEN '{{ $json.body.responsibleUserId !== undefined }}' = 'true'\n        THEN NULLIF(\n          '{{ $json.body.responsibleUserId || \"\" }}',\n          ''\n        )::uuid\n        ELSE responsible_user_id\n      END,\n\n    updated_by =\n      CASE\n        WHEN '{{ $json.body.updatedBy !== undefined }}' = 'true'\n        THEN NULLIF(\n          '{{ $json.body.updatedBy || \"\" }}',\n          ''\n        )::uuid\n        ELSE updated_by\n      END,\n\n    updated_at = NOW()\n\n  WHERE id = COALESCE(\n    NULLIF('{{ $json.body.id || \"\" }}', '')::uuid,\n    NULLIF('{{ $json.body.documentId || \"\" }}', '')::uuid\n  )\n\n  RETURNING id\n)\n\nSELECT\n  d.id,\n  d.title,\n\n  d.sector_id AS \"sectorId\",\n  s.name AS \"sectorName\",\n\n  d.category_id AS \"categoryId\",\n  c.name AS \"categoryName\",\n  c.description AS \"categoryDescription\",\n\n  d.subcategory_id AS \"subcategoryId\",\n  sc.name AS \"subcategoryName\",\n  sc.description AS \"subcategoryDescription\",\n\n  d.semantic_description AS \"semanticDescription\",\n  d.expiration_date AS \"expirationDate\",\n\n  d.file_name AS \"fileName\",\n  d.file_type AS \"fileType\",\n  d.file_size AS \"fileSize\",\n  d.file_path AS \"filePath\",\n\n  d.extracted_text AS \"extractedText\",\n  d.processing_status AS \"processingStatus\",\n  d.processed_at AS \"processedAt\",\n\n  d.responsible_user_id AS \"responsibleUserId\",\n  ru.name AS \"responsibleUserName\",\n\n  d.created_by AS \"createdBy\",\n  cb.name AS \"createdByName\",\n\n  d.updated_by AS \"updatedBy\",\n  ub.name AS \"updatedByName\",\n\n  d.created_at AS \"createdAt\",\n  d.updated_at AS \"updatedAt\"\n\nFROM documents d\n\nLEFT JOIN sectors s\n  ON s.id = d.sector_id\n\nLEFT JOIN categories c\n  ON c.id = d.category_id\n\nLEFT JOIN subcategories sc\n  ON sc.id = d.subcategory_id\n\nLEFT JOIN users ru\n  ON ru.id = d.responsible_user_id\n\nLEFT JOIN users cb\n  ON cb.id = d.created_by\n\nLEFT JOIN users ub\n  ON ub.id = d.updated_by\n\nWHERE d.id = (\n  SELECT id\n  FROM updated_document\n);","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[208,0],"id":"970eda15-ce4d-4c87-bb30-bba33c09960e","name":"Execute a SQL query"