{"id":"z63rJlQKqheFBw4u","name":"PUT Usuários","nodes":[{"parameters":{"httpMethod":"PUT","path":"users/update","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"57c37b1f-529d-490d-9056-6c8954f91748","name":"Webhook","webhookId":"dc9b3eff-3ae4-405d-b427-54ee42fb75e4"},{"parameters":{"operation":"executeQuery","query":"WITH updated_user AS (\n  UPDATE users\n  SET\n    name = '{{ String(($(\"Webhook\").item.json.body.name || \"\")).replace(/'/g, \"''\") }}',\n    email = '{{ String(($(\"Webhook\").item.json.body.email || \"\")).trim().toLowerCase().replace(/'/g, \"''\") }}',\n    sector_id = NULLIF('{{ $(\"Webhook\").item.json.body.sectorId || \"\" }}', '')::uuid,\n    active = {{ $(\"Webhook\").item.json.body.active === false || $(\"Webhook\").item.json.body.active === 'false' ? 'FALSE' : 'TRUE' }},\n    is_master = {{ $(\"Webhook\").item.json.body.isMaster === true || $(\"Webhook\").item.json.body.isMaster === 'true' ? 'TRUE' : 'FALSE' }},\n    password_hash = CASE\n      WHEN NULLIF('{{ String(($(\"Webhook\").item.json.body.passwordHash || $(\"Webhook\").item.json.body.password || \"\")).replace(/'/g, \"''\") }}', '') IS NOT NULL\n      THEN crypt(\n        '{{ String(($(\"Webhook\").item.json.body.passwordHash || $(\"Webhook\").item.json.body.password || \"\")).replace(/'/g, \"''\") }}',\n        gen_salt('bf', 10)\n      )\n      ELSE password_hash\n    END,\n    updated_at = NOW()\n  WHERE id = '{{ $(\"Webhook\").item.json.body.id }}'::uuid\n  RETURNING id\n),\ndeleted_permissions AS (\n  DELETE FROM user_permissions\n  WHERE user_id IN (SELECT id FROM updated_user)\n  RETURNING user_id\n)\nSELECT u.id\nFROM updated_user u\nWHERE (SELECT COUNT(*) FROM deleted_permissions) >= 0;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[560,-40],"id":"87d467f2-16b4-4543-8eb0-ea6574ec0cb8","name":"Execute a SQL query","credentials":{"postgres":{"id":"XJtGZ5rpCR7BpN0X","name":"Postgres account"}}},{"parameters":{"options":{"responseCode":"={{ $json.statusCode }}","responseHeaders":{"entries":[{"name":"X-Request-Id","value":"={{ $json.responseHeaders && $json.responseHeaders[\"X-Request-Id\"] ? $json.responseHeaders[\"X-Request-Id\"] : ($json.requestId || \"\") }}"},{"name":"X-Response-Time-Ms","value":"={{ $json.responseHeaders && $json.responseHeaders[\"X-Response-Time-Ms\"] ? $json.responseHeaders[\"X-Response-Time-Ms\"] : String($json.durationMs || 0) }}"}]}},"respondWith":"json","responseBody":"={{ $json.response }}"},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1000,-40],"id":"40365f92-d548-4221-a7b0-34f049d6a49d","name":"Respond to Webhook"},{"id":"5f49d42a-5ab3-407a-98c6-92c0db89f638","name":"Salvar permissões","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[780,-40],"parameters":{"operation":"executeQuery","query":"WITH inserted_permissions AS (\n  INSERT INTO user_permissions (user_id, permission_id)\n  SELECT DISTINCT\n    '{{ $json.id }}'::uuid,\n    p.id\n  FROM permissions p\n  WHERE p.code <> 'gerenciar_tags'\n    AND p.code IN (\n      SELECT DISTINCT jsonb_array_elements_text(\n        '{{ JSON.stringify($(\"Webhook\").item.json.body.permissions || []) }}'::jsonb\n      )\n    )\n  ON CONFLICT (user_id, permission_id) DO NOTHING\n  RETURNING permission_id\n)\nSELECT\n  u.id,\n  u.name,\n  u.email,\n  u.sector_id AS \"sectorId\",\n  s.name AS \"sectorName\",\n  u.active,\n  u.is_master AS \"isMaster\",\n  COALESCE(\n    (\n      SELECT json_agg(p.code ORDER BY p.code)\n      FROM inserted_permissions ip\n      JOIN permissions p ON p.id = ip.permission_id\n      WHERE p.code <> 'gerenciar_tags'\n    ),\n    '[]'::json\n  ) AS permissions,\n  u.created_at AS \"createdAt\",\n  u.updated_at AS \"updatedAt\"\nFROM users u\nLEFT JOIN sectors s ON s.id = u.sector_id\nWHERE u.id = '{{ $json.id }}'::uuid;","options":{}},"credentials":{"postgres":{"id":"XJtGZ5rpCR7BpN0X","name":"Postgres account"}}},{"id":"47910694-9a9d-492b-b0bd-664bb9d3e3d8","name":"Auth ok?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[320,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"a1","leftValue":"={{ $json.ok }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"},"looseTypeValidation":true}},{"id":"7d22c18b-4908-4902-92d7-4a9cfb5573df","name":"Respond 401","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[560,120],"parameters":{"respondWith":"json","responseBody":"={{ $json.response }}","options":{"responseCode":401,"responseHeaders":{"entries":[{"name":"X-Request-Id","value":"={{ $json.responseHeaders && $json.responseHeaders[\"X-Request-Id\"] ? $json.responseHeaders[\"X-Request-Id\"] : ($json.requestId || \"\") }}"},{"name":"X-Response-Time-Ms","value":"={{ $json.responseHeaders && $json.responseHeaders[\"X-Response-Time-Ms\"] ? $json.responseHeaders[\"X-Response-Time-Ms\"] : String($json.durationMs || 0) }}"}]}}}},{"id":"6986b497-2891-4c7d-926c-0802bd04f3f0","name":"Validar auth","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[120,0],"parameters":{"source":"database","workflowId":{"__rl":true,"mode":"id","value":"P5E43ZXSJiI9wFYD","cachedResultName":"AUTH - VALIDAR TOKEN"},"mode":"once","workflowInputs":{"mappingMode":"defineBelow","value":{"authorization":"={{ $json.authorization || $json.headers.authorization || $json.headers.Authorization || '' }}","requestId":"={{ $json.requestId || '' }}"}},"options":{"waitForSubWorkflow":true}}},{"id":"5db1f3dd-8481-4269-a6e7-9b3bd5b46941","name":"Validar permissão","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[440,-40],"parameters":{"source":"database","workflowId":{"__rl":true,"mode":"id","value":"yXW3rW8EbHXuprRJ","cachedResultName":"AUTH - VALIDAR PERMISSÃO"},"mode":"once","workflowInputs":{"mappingMode":"defineBelow","value":{"pe