    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH new_user AS (\n  INSERT INTO users (\n    name,\n    email,\n    password_hash,\n    sector_id,\n    active,\n    is_master\n  )\n  VALUES (\n    '{{ String(($(\"Webhook\").item.json.body.name || \"\")).replace(/'/g, \"''\") }}',\n    '{{ String(($(\"Webhook\").item.json.body.email || \"\")).trim().toLowerCase().replace(/'/g, \"''\") }}',\n    crypt(\n      '{{ String(($(\"Webhook\").item.json.body.passwordHash || $(\"Webhook\").item.json.body.password || \"\")).replace(/'/g, \"''\") }}',\n      gen_salt('bf', 10)\n    ),\n    NULLIF('{{ $(\"Webhook\").item.json.body.sectorId || \"\" }}', '')::uuid,\n    {{ $(\"Webhook\").item.json.body.active === false || $(\"Webhook\").item.json.body.active === 'false' ? 'FALSE' : 'TRUE' }},\n    {{ $(\"Webhook\").item.json.body.isMaster === true || $(\"Webhook\").item.json.body.isMaster === 'true' ? 'TRUE' : 'FALSE' }}\n  )\n  RETURNING id, name, email, sector_id, active, is_master, created_at, updated_at\n),\ninserted_permissions AS (\n  INSERT INTO user_permissions (user_id, permission_id)\n  SELECT DISTINCT\n    new_user.id,\n    p.id\n  FROM new_user\n  CROSS JOIN permissions p\n  WHERE p.code <> 'gerenciar_tags'\n    AND p.code IN (\n      SELECT DISTINCT jsonb_array_elements_text(\n        '{{ JSON.stringify($(\"Webhook\").item.json.body.permissions || []) }}'::jsonb\n      )\n    )\n  ON CONFLICT (user_id, permission_id) DO NOTHING\n  RETURNING permission_id\n)\nSELECT\n  u.id,\n  u.name,\n  u.email,\n  u.sector_id AS \"sectorId\",\n  s.name AS \"sectorName\",\n  u.active,\n  u.is_master AS \"isMaster\",\n  COALESCE(\n    (\n      SELECT json_agg(p.code ORDER BY p.code)\n      FROM inserted_permissions ip\n      JOIN permissions p ON p.id = ip.permission_id\n      WHERE p.code <> 'gerenciar_tags'\n    ),\n    '[]'::json\n  ) AS permissions,\n  u.created_at AS \"createdAt\",\n  u.updated_at AS \"updatedAt\"\nFROM new_user u\nLEFT JOIN sectors s ON s.id = u.sector_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        560,
        -40
      ],
