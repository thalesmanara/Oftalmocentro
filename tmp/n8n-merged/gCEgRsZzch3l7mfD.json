      ],
      "parameters": {
        "jsCode": "const err = $input.first().json || {};\nconst msg = String(err.message || err.error?.message || err.description || JSON.stringify(err));\nconst isDuplicate = /users_email_key|duplicate key.*email|unique constraint.*email/i.test(msg);\nconst requestId = $('Normalizar request').first().json.requestId;\nif (isDuplicate) {\n  return [{ json: { code: 'USER_EMAIL_ALREADY_EXISTS', message: 'Já existe um usuário com este e-mail.', statusCode: 409, requestId } }];\n}\nreturn [{ json: { code: 'INTERNAL_ERROR', message: 'Ocorreu um erro inesperado.', statusCode: 500, requestId } }];",
